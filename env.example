# ─────────────────────────────────────────────────────────────────────────────
# Knowledge Vault — copy this file to `.env` and fill in your Firebase values.
#
#   1. Firebase console → create (or pick) a project.
#   2. Build → AI Logic → Get started, choose the *Gemini Developer API* provider.
#      That guided flow registers a Web app and enables App Check for AI Logic.
#   3. Project settings → General → Your apps → Web app → "SDK setup and
#      configuration" → Config. Copy apiKey / projectId / appId from there.
#   4. Security → App Check → Apps → your web app → create a reCAPTCHA Enterprise
#      key and paste it as VITE_APPCHECK_SITE_KEY (App Check is enforced).
#
# `.env` is git-ignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Required — the SDK will not start without these three.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check is enforced for Firebase AI Logic. A deployed build needs this
# reCAPTCHA Enterprise site key; on localhost the debug token below is enough
# on its own (Firebase allows enforcement with only the debug provider).
VITE_APPCHECK_SITE_KEY=

# Optional, straight from the same Firebase config block.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local dev. Set this to `true`, open the app, copy the "AppCheck debug token"
# from the browser console, and add it under App Check → Apps → ⋮ → Manage
# debug tokens. Leave the site key empty if you only use this on localhost.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional. Cloud-hosted fallback model. Docs default is gemini-3.5-flash-lite;
# Gemini 2.5 models are deprecated for this API.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
